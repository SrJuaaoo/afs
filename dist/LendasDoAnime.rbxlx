    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">GameConfig</string>
        <string name="Source"><![CDATA[local Config = {}
Config.Title = "LENDAS DO ANIME"
Config.MaxEquipped = 3
Config.MaxInventory = 120
Config.AttackRange = 65
Config.AttackInterval = 0.8
Config.SaveInterval = 60
Config.Worlds = {
    {Name = "Vila da Aurora", Cost = 0, SummonCost = 100, Color = Color3.fromRGB(65, 196, 143), Enemy = "Sentinela Sombria", Health = 80, Reward = 35},
    {Name = "Deserto Celeste", Cost = 2500, SummonCost = 650, Color = Color3.fromRGB(244, 183, 76), Enemy = "Guardião das Areias", Health = 700, Reward = 240},
    {Name = "Cidadela Lunar", Cost = 18000, SummonCost = 3500, Color = Color3.fromRGB(147, 116, 244), Enemy = "Cavaleiro do Eclipse", Health = 4500, Reward = 1500},
}
Config.Fighters = {
    {Id = "haru", Name = "Haru da Brisa", Rarity = "Comum", Weight = 55, Power = 8, Color = Color3.fromRGB(126, 195, 233)},
    {Id = "akemi", Name = "Akemi das Chamas", Rarity = "Raro", Weight = 28, Power = 16, Color = Color3.fromRGB(80, 153, 255)},
    {Id = "raiden", Name = "Raiden do Trovão", Rarity = "Épico", Weight = 12, Power = 34, Color = Color3.fromRGB(182, 104, 255)},
    {Id = "hoshi", Name = "Hoshi Estelar", Rarity = "Lendário", Weight = 4, Power = 80, Color = Color3.fromRGB(255, 193, 68)},
    {Id = "yume", Name = "Yume do Infinito", Rarity = "Mítico", Weight = 1, Power = 200, Color = Color3.fromRGB(255, 91, 146)},
}
Config.QuestGoal = 10
Config.QuestReward = 500
function Config.GetFighter(id)
    for _, fighter in ipairs(Config.Fighters) do
        if fighter.Id == id then return fighter end
    end
end
function Config.Power(fighter)
    local base = Config.GetFighter(fighter.Kind)
    return math.floor(base.Power * (1 + (fighter.Level - 1) * 0.2) * (3 ^ (fighter.World - 1)))
end
return Config
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="2">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="3">
      <Properties>
        <string name="Name">GameServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local remote = Instance.new("RemoteEvent")
remote.Name = "GameEvent"
remote.Parent = ReplicatedStorage
local store = DataStoreService:GetDataStore("LendasDoAnime_v1")
local profiles, targets, cooldowns, enemies, pets = {}, {}, {}, {}, {}
local random = Random.new()
local map = Instance.new("Folder")
map.Name = "LendasWorld"
map.Parent = workspace
workspace.FallenPartsDestroyHeight = -100
game:GetService("Lighting").ClockTime = 14
game:GetService("Lighting").Brightness = 2

local function part(name, size, position, color, parent)
    local p = Instance.new("Part")
    p.Name, p.Size, p.Position, p.Color = name, size, position, color
    p.Anchored, p.TopSurface, p.BottomSurface = true, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Parent = parent or map
    return p
end
local function label(adornee, text, color, offset)
    local gui = Instance.new("BillboardGui")
    gui.Size, gui.StudsOffset, gui.AlwaysOnTop = UDim2.fromOffset(240, 60), Vector3.new(0, offset or 5, 0), true
    gui.Parent = adornee
    local t = Instance.new("TextLabel")
    t.Size, t.BackgroundTransparency, t.Text = UDim2.fromScale(1, 1), 1, text
    t.TextColor3, t.TextStrokeTransparency, t.TextScaled = color or Color3.new(1, 1, 1), 0.4, true
    t.Font, t.Parent = Enum.Font.GothamBold, gui
    return t
end
local function prompt(parent, action, object, callback)
    local p = Instance.new("ProximityPrompt")
    p.ActionText, p.ObjectText, p.HoldDuration = action, object, 0.25
    p.MaxActivationDistance, p.RequiresLineOfSight, p.Parent = 14, false, parent
    p.Triggered:Connect(callback)
end
local function send(player)
    local profile = profiles[player]
    if profile then remote:FireClient(player, "State", profile) end
end
local function toast(player, message)
    remote:FireClient(player, "Toast", message)
end
local function root(player)
    return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end
local function spawnPosition(world)
    return Vector3.new((world - 1) * 650, 6, 55)
end
local function fighter(kind, world)
    return {Uid = HttpService:GenerateGUID(false), Kind = kind, Level = 1, XP = 0, World = world}
end
local function newProfile()
    local starter = fighter("haru", 1)
    return {Coins = 300, World = 1, Unlocked = 1, Inventory = {starter}, Equipped = {starter.Uid}, Kills = 0, QuestClaimed = 0}
end
local function equipped(profile, uid)
    return table.find(profile.Equipped, uid) ~= nil
end
local function rebuildPets(player)
    if pets[player] then pets[player]:Destroy() end
    local folder = Instance.new("Folder")
    folder.Name, folder.Parent = "Equipe_" .. player.UserId, map
    pets[player] = folder
    for _, f in ipairs(profiles[player].Inventory) do
        if equipped(profiles[player], f.Uid) then
            local definition = Config.GetFighter(f.Kind)
            local model = Instance.new("Model")
            model.Name, model.Parent = f.Uid, folder
            local body = part("Body", Vector3.new(1.6, 2, 1), spawnPosition(1), definition.Color, model)
            local head = part("Head", Vector3.new(1.2, 1.2, 1.2), body.Position + Vector3.new(0, 1.6, 0), Color3.fromRGB(255, 217, 183), model)
            body.CanCollide, head.CanCollide = false, false
            model.PrimaryPart = body
            label(head, definition.Name .. " · Nv. " .. f.Level, definition.Color, 2.5)
        end
    end
end
local function summon(player)
    local p, r = profiles[player], root(player)
    if not p or not r then return end
    local altar = Vector3.new((p.World - 1) * 650 - 30, 4, 20)
    if (r.Position - altar).Magnitude > 22 then toast(player, "Aproxime-se da Estrela de Invocação!"); return end
    local cost = Config.Worlds[p.World].SummonCost
    if p.Coins < cost then toast(player, "Moedas insuficientes!"); return end
    if #p.Inventory >= Config.MaxInventory then toast(player, "Inventário cheio! Venda lutadores para liberar espaço."); return end
    p.Coins = p.Coins - cost
    local roll, sum, chosen = random:NextInteger(1, 100), 0, Config.Fighters[1]
    for _, def in ipairs(Config.Fighters) do
        sum = sum + def.Weight
        if roll <= sum then chosen = def; break end
    end
    local f = fighter(chosen.Id, p.World)
    table.insert(p.Inventory, f)
    if #p.Equipped < Config.MaxEquipped then table.insert(p.Equipped, f.Uid); rebuildPets(player) end
    send(player)
    remote:FireClient(player, "Summoned", f)
end
local function travel(player, world)
    local p, r = profiles[player], root(player)
    if not p or not r or type(world) ~= "number" or world % 1 ~= 0 or not Config.Worlds[world] then return end
    if world > p.Unlocked then
        if world ~= p.Unlocked + 1 then toast(player, "Desbloqueie a ilha anterior primeiro!"); return end
        local cost = Config.Worlds[world].Cost
        if p.Coins < cost then toast(player, "Você precisa de " .. cost .. " moedas para esta ilha."); return end
        p.Coins, p.Unlocked = p.Coins - cost, world
    end
    p.World, targets[player] = world, nil
    r.CFrame = CFrame.new(spawnPosition(world))
    send(player)
end

for index, world in ipairs(Config.Worlds) do
    local x = (index - 1) * 650
    part(world.Name, Vector3.new(190, 4, 190), Vector3.new(x, 0, 0), world.Color)
    part("Caminho", Vector3.new(20, 0.2, 155), Vector3.new(x, 2.1, 0), Color3.fromRGB(225, 215, 194))
    local sign = part("Placa", Vector3.new(1, 1, 1), Vector3.new(x, 10, 75), world.Color)
    sign.Transparency, sign.CanCollide = 1, false
    label(sign, world.Name, Color3.new(1, 1, 1), 0)
    local altar = part("Estrela", Vector3.new(5, 5, 5), Vector3.new(x - 30, 5, 20), Color3.fromRGB(255, 215, 80))
    altar.Material, altar.Shape = Enum.Material.Neon, Enum.PartType.Ball
    label(altar, "INVOCAÇÃO\n" .. world.SummonCost .. " moedas", Color3.fromRGB(255, 232, 130))
    prompt(altar, "Invocar", "Estrela · " .. world.SummonCost .. " moedas", summon)
    if index < #Config.Worlds then
        local portal = part("Portal", Vector3.new(12, 14, 2), Vector3.new(x, 9, -80), Config.Worlds[index + 1].Color)
        portal.Material, portal.CanCollide = Enum.Material.Neon, false
        label(portal, Config.Worlds[index + 1].Name .. "\n" .. Config.Worlds[index + 1].Cost .. " moedas", nil, 10)
        prompt(portal, "Viajar / desbloquear", Config.Worlds[index + 1].Name, function(player) travel(player, index + 1) end)
    end
    for n = 1, 12 do
        local angle = n * math.pi / 6
        local pos = Vector3.new(x + math.cos(angle) * 78, 8, math.sin(angle) * 78)
        part("Tronco", Vector3.new(3, 12, 3), pos, Color3.fromRGB(101, 74, 62))
        local canopy = part("Copa", Vector3.new(15, 15, 15), pos + Vector3.new(0, 10, 0), world.Color:Lerp(Color3.fromRGB(30, 90, 75), 0.4))
        canopy.Shape = Enum.PartType.Ball
    end
    for n = 1, 5 do
        local boss = n == 5
        local pos = Vector3.new(x + ((n - 1) % 3 - 1) * 28, 6, -12 - math.floor((n - 1) / 3) * 32)
        local model = Instance.new("Model")
        model.Name, model.Parent = boss and "Chefe " .. world.Enemy or world.Enemy, map
        local body = part("Body", boss and Vector3.new(6, 7, 4) or Vector3.new(3, 4, 2), pos, boss and Color3.fromRGB(166, 64, 104) or Color3.fromRGB(65, 64, 90), model)
        local head = part("Head", Vector3.new(2.5, 2.5, 2.5), pos + Vector3.new(0, boss and 5 or 3, 0), Color3.fromRGB(200, 177, 190), model)
        model.PrimaryPart = body
        local health = world.Health * (boss and 8 or 1)
        local entry = {Model = model, Body = body, Head = head, World = index, Health = health, MaxHealth = health, Reward = world.Reward * (boss and 6 or 1), Dead = false}
        entry.Label = label(head, model.Name .. "\n" .. health .. " / " .. health, nil, 4)
        enemies[model] = entry
        local click = Instance.new("ClickDetector")
        click.MaxActivationDistance, click.Parent = Config.AttackRange, body
        click.MouseClick:Connect(function(player)
            local p, r = profiles[player], root(player)
            if p and r and p.World == index and not entry.Dead and (r.Position - body.Position).Magnitude <= Config.AttackRange then
                targets[player] = entry
                remote:FireClient(player, "Target", model)
            end
        end)
        prompt(body, "Atacar", model.Name, function(player)
            local p, r = profiles[player], root(player)
            if p and r and p.World == index and not entry.Dead and (r.Position - body.Position).Magnitude <= 22 then
                targets[player] = entry
                remote:FireClient(player, "Target", model)
            end
        end)
    end
end
local spawn = Instance.new("SpawnLocation")
spawn.Size, spawn.Position, spawn.Anchored, spawn.Neutral = Vector3.new(10, 1, 10), spawnPosition(1) - Vector3.new(0, 3, 0), true, true
spawn.Color, spawn.Parent = Color3.fromRGB(240, 240, 255), map
local function validProfile(p)
    if type(p) ~= "table" or type(p.Inventory) ~= "table" or #p.Inventory > Config.MaxInventory or type(p.Equipped) ~= "table" then return false end
    for _, key in ipairs({"Coins", "World", "Unlocked", "Kills", "QuestClaimed"}) do
        if type(p[key]) ~= "number" or p[key] ~= p[key] or p[key] < 0 or p[key] % 1 ~= 0 then return false end
    end
    if not Config.Worlds[p.World] or not Config.Worlds[p.Unlocked] or p.World > p.Unlocked or #p.Equipped > Config.MaxEquipped then return false end
    local ids = {}
    for _, f in ipairs(p.Inventory) do
        if type(f) ~= "table" or type(f.Uid) ~= "string" or ids[f.Uid] or not Config.GetFighter(f.Kind) or not Config.Worlds[f.World] or type(f.Level) ~= "number" or f.Level < 1 or type(f.XP) ~= "number" or f.XP < 0 then return false end
        ids[f.Uid] = true
    end
    local used = {}
    for _, uid in ipairs(p.Equipped) do
        if not ids[uid] or used[uid] then return false end
        used[uid] = true
    end
    return true
end
local function save(player)
    local p = profiles[player]
    if not p then return end
    local ok, err = pcall(function() store:SetAsync("Player_" .. player.UserId, p) end)
    if not ok then warn("Falha ao salvar jogador " .. player.UserId .. ": " .. tostring(err)) end
end
Players.PlayerAdded:Connect(function(player)
    local ok, data = pcall(function() return store:GetAsync("Player_" .. player.UserId) end)
    if not ok then
        if RunService:IsStudio() then
            data = nil
            player:SetAttribute("SessionOnly", true)
            warn("DataStore indisponível no Studio; progresso somente nesta sessão.")
        else player:Kick("Não foi possível carregar seu progresso. Tente entrar novamente."); return end
    end
    if ok and data ~= nil and not validProfile(data) then player:Kick("Seu progresso precisa de revisão. Contate o desenvolvedor."); return end
    if not player.Parent then return end
    profiles[player] = data or newProfile()
    rebuildPets(player)
    local function characterAdded(character)
        local r = character:WaitForChild("HumanoidRootPart", 10)
        if r and profiles[player] then r.CFrame = CFrame.new(spawnPosition(profiles[player].World)) end
    end
    player.CharacterAdded:Connect(characterAdded)
    if player.Character then task.spawn(characterAdded, player.Character) end
    send(player)
end)
remote.OnServerEvent:Connect(function(player, action, value)
    local p = profiles[player]
    if not p or type(action) ~= "string" then return end
    local now = os.clock()
    if now - (cooldowns[player] or 0) < 0.15 then return end
    cooldowns[player] = now
    if action == "Ready" then send(player)
    elseif action == "Summon" then summon(player)
    elseif action == "Travel" then travel(player, value)
    elseif action == "Stop" then targets[player] = nil
    elseif action == "Quest" then
        if p.Kills >= (p.QuestClaimed + 1) * Config.QuestGoal then
            p.QuestClaimed, p.Coins = p.QuestClaimed + 1, p.Coins + Config.QuestReward
            toast(player, "Missão concluída! +" .. Config.QuestReward .. " moedas")
            send(player)
        else toast(player, "Derrote mais inimigos para concluir a missão.") end
    elseif action == "Best" then
        local sorted = table.clone(p.Inventory)
        table.sort(sorted, function(a, b) return Config.Power(a) > Config.Power(b) end)
        p.Equipped = {}
        for i = 1, math.min(Config.MaxEquipped, #sorted) do table.insert(p.Equipped, sorted[i].Uid) end
        rebuildPets(player); send(player)
    elseif (action == "Equip" or action == "Sell") and type(value) == "string" then
        for i, f in ipairs(p.Inventory) do
            if f.Uid == value then
                local slot = table.find(p.Equipped, value)
                if action == "Equip" then
                    if slot then table.remove(p.Equipped, slot)
                    elseif #p.Equipped < Config.MaxEquipped then table.insert(p.Equipped, value)
                    else toast(player, "Equipe no máximo " .. Config.MaxEquipped .. " lutadores.") end
                elseif not slot and #p.Inventory > 1 then
                    p.Coins = p.Coins + math.floor(Config.Power(f) * 2)
                    table.remove(p.Inventory, i)
                else toast(player, "Desequipe o lutador antes de vender. Mantenha ao menos um.") end
                rebuildPets(player); send(player); break
            end
        end
    end
end)
local attackClock = 0
RunService.Heartbeat:Connect(function(dt)
    attackClock = attackClock + dt
    local attack = attackClock >= Config.AttackInterval
    if attack then attackClock = 0 end
    for player, p in pairs(profiles) do
        local r, enemy = root(player), targets[player]
        if enemy and (enemy.Dead or not r or p.World ~= enemy.World or (r.Position - enemy.Body.Position).Magnitude > Config.AttackRange) then
            targets[player], enemy = nil, nil
            remote:FireClient(player, "Target", nil)
        end
        local folder = pets[player]
        if r and folder then
            for i, model in ipairs(folder:GetChildren()) do
                local pos
                if enemy then
                    local angle = i * math.pi * 2 / math.max(1, #p.Equipped)
                    pos = enemy.Body.Position + Vector3.new(math.cos(angle) * 6, 0, math.sin(angle) * 6)
                else pos = (r.CFrame * CFrame.new((i - 2) * 4, -1, 6)).Position end
                local destination = CFrame.lookAt(pos, enemy and enemy.Body.Position or pos + r.CFrame.LookVector)
                model:PivotTo(model:GetPivot():Lerp(destination, math.min(dt * 8, 1)))
            end
        end
        if attack and enemy then
            local damage = 0
            for _, f in ipairs(p.Inventory) do if equipped(p, f.Uid) then damage = damage + Config.Power(f) end end
            enemy.Health = math.max(0, enemy.Health - damage)
            enemy.Label.Text = enemy.Model.Name .. "\n" .. enemy.Health .. " / " .. enemy.MaxHealth
            if damage > 0 then remote:FireClient(player, "Damage", enemy.Body.Position, damage) end
            if enemy.Health <= 0 and not enemy.Dead then
                enemy.Dead, targets[player] = true, nil
                p.Coins, p.Kills = p.Coins + enemy.Reward, p.Kills + 1
                for _, f in ipairs(p.Inventory) do
                    if equipped(p, f.Uid) then
                        f.XP = f.XP + 1
                        if f.XP >= f.Level * 5 then f.XP, f.Level = 0, f.Level + 1 end
                    end
                end
                for _, child in ipairs(enemy.Model:GetChildren()) do if child:IsA("BasePart") then child.Transparency, child.CanCollide = 1, false end end
                enemy.Label.Text = "Renascendo..."
                toast(player, "+" .. enemy.Reward .. " moedas!")
                rebuildPets(player); send(player)
                remote:FireClient(player, "Target", nil)
                task.delay(7, function()
                    enemy.Health, enemy.Dead = enemy.MaxHealth, false
                    enemy.Label.Text = enemy.Model.Name .. "\n" .. enemy.Health .. " / " .. enemy.MaxHealth
                    for _, child in ipairs(enemy.Model:GetChildren()) do if child:IsA("BasePart") then child.Transparency, child.CanCollide = 0, true end end
                end)
            end
        end
    end
end)
Players.PlayerRemoving:Connect(function(player)
    if not player:GetAttribute("SessionOnly") then save(player) end
    profiles[player], targets[player], cooldowns[player] = nil, nil, nil
    if pets[player] then pets[player]:Destroy(); pets[player] = nil end
end)
task.spawn(function()
    while true do
        task.wait(Config.SaveInterval)
        for player in pairs(profiles) do if not player:GetAttribute("SessionOnly") then save(player) end end
    end
end)
game:BindToClose(function()
    local pending = 0
    for player in pairs(profiles) do
        if not player:GetAttribute("SessionOnly") then
            pending = pending + 1
            task.spawn(function() save(player); pending = pending - 1 end)
        end
    end
    local deadline = os.clock() + 25
    while pending > 0 and os.clock() < deadline do task.wait(0.1) end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="4">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="5">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="6">
        <Properties>
          <string name="Name">GameClient</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local remote = ReplicatedStorage:WaitForChild("GameEvent")
local state, activeTab = nil, nil
local colors = {Background = Color3.fromRGB(15, 20, 37), Panel = Color3.fromRGB(25, 33, 55), Text = Color3.fromRGB(239, 244, 255), Muted = Color3.fromRGB(159, 175, 203), Accent = Color3.fromRGB(75, 224, 174)}
local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn, gui.ZIndexBehavior = "LendasUI", false, Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")
local function corner(object, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius, c.Parent = UDim.new(0, radius or 12), object
end
local function frame(parent, size, position, color)
    local f = Instance.new("Frame")
    f.Size, f.Position, f.BackgroundColor3, f.BorderSizePixel, f.Parent = size, position, color or colors.Panel, 0, parent
    corner(f)
    return f
end
local function text(parent, value, size, position, fontSize, color)
    local t = Instance.new("TextLabel")
    t.Size, t.Position, t.Text, t.TextSize = size, position, value, fontSize or 16
    t.BackgroundTransparency, t.TextColor3, t.Font = 1, color or colors.Text, Enum.Font.GothamBold
    t.TextWrapped, t.Parent = true, parent
    return t
end
local function button(parent, value, size, position, callback, color)
    local b = Instance.new("TextButton")
    b.Size, b.Position, b.Text, b.TextSize = size, position, value, 15
    b.BackgroundColor3, b.TextColor3, b.Font = color or colors.Accent, colors.Background, Enum.Font.GothamBold
    b.BorderSizePixel, b.TextWrapped, b.Parent = 0, true, parent
    corner(b, 9)
    b.Activated:Connect(callback)
    return b
end
local function number(n)
    if n >= 1000000 then return string.format("%.1f mi", n / 1000000) end
    if n >= 1000 then return string.format("%.1f mil", n / 1000) end
    return tostring(n)
end
local header = frame(gui, UDim2.new(1, -32, 0, 76), UDim2.fromOffset(16, 12), colors.Background)
local title = text(header, Config.Title, UDim2.new(0.5, 0, 0, 30), UDim2.fromOffset(12, 9), 21)
title.TextXAlignment = Enum.TextXAlignment.Left
local subtitle = text(header, "INVOQUE. EVOLUA. CONQUISTE.", UDim2.new(0.5, 0, 0, 20), UDim2.fromOffset(12, 41), 11, colors.Muted)
subtitle.TextXAlignment = Enum.TextXAlignment.Left
local coins = text(header, "Carregando...", UDim2.new(0.46, 0, 0, 30), UDim2.new(0.53, 0, 0, 9), 19, Color3.fromRGB(255, 213, 93))
local power = text(header, "", UDim2.new(0.46, 0, 0, 20), UDim2.new(0.53, 0, 0, 43), 12, colors.Muted)
local nav = frame(gui, UDim2.new(1, -32, 0, 54), UDim2.new(0, 16, 1, -68), colors.Background)
local modal = frame(gui, UDim2.new(0.9, 0, 0.64, 0), UDim2.fromScale(0.05, 0.19), colors.Background)
local constraint = Instance.new("UISizeConstraint")
constraint.MaxSize, constraint.Parent = Vector2.new(820, 620), modal
modal.AnchorPoint, modal.Position, modal.Visible = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.51), false
local heading = text(modal, "", UDim2.new(1, -75, 0, 45), UDim2.fromOffset(15, 6), 23)
heading.TextXAlignment = Enum.TextXAlignment.Left
button(modal, "X", UDim2.fromOffset(36, 34), UDim2.new(1, -46, 0, 10), function() modal.Visible = false; activeTab = nil end, Color3.fromRGB(255, 117, 141))
local content = Instance.new("ScrollingFrame")
content.Position, content.Size = UDim2.fromOffset(12, 60), UDim2.new(1, -24, 1, -72)
content.BackgroundTransparency, content.BorderSizePixel, content.ScrollBarThickness = 1, 0, 5
content.AutomaticCanvasSize, content.CanvasSize, content.Parent = Enum.AutomaticSize.Y, UDim2.new(), modal
local layout = Instance.new("UIListLayout")
layout.Padding, layout.SortOrder, layout.Parent = UDim.new(0, 10), Enum.SortOrder.LayoutOrder, content
local toastLabel = text(gui, "", UDim2.new(0.9, 0, 0, 48), UDim2.fromScale(0.05, 0.12), 18, Color3.fromRGB(255, 230, 135))
toastLabel.TextStrokeTransparency = 0.45
local toastSequence = 0
local function toast(message)
    toastSequence = toastSequence + 1
    local sequence = toastSequence
    toastLabel.Text = message
    task.delay(4, function() if sequence == toastSequence then toastLabel.Text = "" end end)
end
local function row(height)
    return frame(content, UDim2.new(1, -8, 0, height or 85), UDim2.new(), colors.Panel)
end
local render
local function open(tab)
    activeTab = tab
    modal.Visible = true
    render()
end
render = function()
    if not state then return end
    coins.Text = "MOEDAS  " .. number(state.Coins)
    local damage = 0
    for _, f in ipairs(state.Inventory) do if table.find(state.Equipped, f.Uid) then damage = damage + Config.Power(f) end end
    power.Text = "Poder: " .. number(damage) .. "  •  Equipe: " .. #state.Equipped .. "/" .. Config.MaxEquipped
    if not activeTab then return end
    for _, child in ipairs(content:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
    if activeTab == "Lutadores" then
        heading.Text = "Seus lutadores · " .. #state.Inventory .. "/" .. Config.MaxInventory
        local top = row(48)
        button(top, "Equipar melhores", UDim2.new(1, -20, 1, -10), UDim2.fromOffset(10, 5), function() remote:FireServer("Best") end)
        local sorted = table.clone(state.Inventory)
        table.sort(sorted, function(a, b) return Config.Power(a) > Config.Power(b) end)
        for _, f in ipairs(sorted) do
            local def, r = Config.GetFighter(f.Kind), row(105)
            local equipped = table.find(state.Equipped, f.Uid) ~= nil
            local name = text(r, def.Name .. " · Nv. " .. f.Level, UDim2.new(1, -20, 0, 28), UDim2.fromOffset(10, 4), 17, def.Color)
            name.TextXAlignment = Enum.TextXAlignment.Left
            local detail = text(r, def.Rarity .. "  •  Poder " .. number(Config.Power(f)) .. "  •  XP " .. f.XP .. "/" .. f.Level * 5, UDim2.new(1, -20, 0, 20), UDim2.fromOffset(10, 33), 12, colors.Muted)
            detail.TextXAlignment = Enum.TextXAlignment.Left
            button(r, equipped and "Desequipar" or "Equipar", UDim2.new(0.48, -10, 0, 32), UDim2.fromOffset(10, 63), function() remote:FireServer("Equip", f.Uid) end, equipped and Color3.fromRGB(132, 162, 215) or colors.Accent)
            button(r, "Vender · " .. number(math.floor(Config.Power(f) * 2)), UDim2.new(0.48, -10, 0, 32), UDim2.new(0.52, 0, 0, 63), function()
                heading.Text = "Confirmar venda de " .. def.Name .. "?"
                for _, child in ipairs(content:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
                local confirm = row(100)
                text(confirm, "Esta venda é permanente.", UDim2.new(1, -20, 0, 38), UDim2.fromOffset(10, 4), 16)
                button(confirm, "Confirmar venda", UDim2.new(0.48, -10, 0, 38), UDim2.fromOffset(10, 50), function() remote:FireServer("Sell", f.Uid) end, Color3.fromRGB(255, 141, 154))
                button(confirm, "Cancelar", UDim2.new(0.48, -10, 0, 38), UDim2.new(0.52, 0, 0, 50), render)
            end, Color3.fromRGB(255, 174, 143))
        end
    elseif activeTab == "Ilhas" then
        heading.Text = "Explore as ilhas"
        for i, world in ipairs(Config.Worlds) do
            local r = row(105)
            text(r, world.Name, UDim2.new(1, -20, 0, 32), UDim2.fromOffset(10, 5), 20, world.Color)
            text(r, i <= state.Unlocked and "Ilha desbloqueada" or "Desbloqueio: " .. number(world.Cost) .. " moedas", UDim2.new(1, -20, 0, 24), UDim2.fromOffset(10, 37), 13, colors.Muted)
            button(r, state.World == i and "Você está aqui" or (i <= state.Unlocked and "Viajar" or "Desbloquear e viajar"), UDim2.new(1, -20, 0, 30), UDim2.fromOffset(10, 67), function() remote:FireServer("Travel", i) end, world.Color)
        end
    elseif activeTab == "Invocar" then
        local world = Config.Worlds[state.World]
        heading.Text = "Estrela · " .. world.Name
        local r = row(115)
        text(r, "Aproxime-se da estrela dourada na ilha.\nCada invocação custa " .. number(world.SummonCost) .. " moedas.", UDim2.new(1, -20, 0, 60), UDim2.fromOffset(10, 3), 16)
        button(r, "INVOCAR LUTADOR", UDim2.new(1, -20, 0, 38), UDim2.fromOffset(10, 68), function() remote:FireServer("Summon") end, Color3.fromRGB(255, 211, 94))
        for _, def in ipairs(Config.Fighters) do
            local chance = row(50)
            text(chance, def.Name .. " · " .. def.Rarity .. " · " .. def.Weight .. "%", UDim2.new(1, -20, 1, 0), UDim2.fromOffset(10, 0), 15, def.Color)
        end
    elseif activeTab == "Missões" then
        heading.Text = "Missão · Patrulha das ilhas"
        local r = row(160)
        local progress = math.min(Config.QuestGoal, math.max(0, state.Kills - state.QuestClaimed * Config.QuestGoal))
        text(r, "Derrote " .. Config.QuestGoal .. " inimigos\nProgresso: " .. progress .. "/" .. Config.QuestGoal .. "\nRecompensa: " .. Config.QuestReward .. " moedas", UDim2.new(1, -20, 0, 90), UDim2.fromOffset(10, 6), 18)
        button(r, "Resgatar recompensa", UDim2.new(1, -20, 0, 40), UDim2.fromOffset(10, 108), function() remote:FireServer("Quest") end)
        local help = row(110)
        text(help, "COMO JOGAR\nToque ou clique no corpo de um inimigo para enviar sua equipe. Aproxime-se para manter o combate. Lutadores equipados ganham XP a cada vitória.", UDim2.new(1, -24, 1, -12), UDim2.fromOffset(12, 6), 14, colors.Muted)
    end
end
for i, tab in ipairs({"Lutadores", "Invocar", "Ilhas", "Missões"}) do
    button(nav, tab, UDim2.new(0.25, -10, 1, -12), UDim2.new((i - 1) * 0.25, 5, 0, 6), function() open(tab) end, i == 2 and Color3.fromRGB(255, 211, 94) or colors.Accent)
end
local stop = button(gui, "PARAR ATAQUE", UDim2.fromOffset(160, 34), UDim2.new(0.5, -80, 1, -112), function() remote:FireServer("Stop") end, Color3.fromRGB(255, 141, 154))
stop.Visible = false
local highlight = Instance.new("Highlight")
highlight.FillTransparency, highlight.OutlineColor, highlight.Parent = 0.85, colors.Accent, workspace
local reveal = frame(gui, UDim2.fromScale(0.84, 0.32), UDim2.fromScale(0.08, 0.33), colors.Background)
reveal.Visible = false
local revealTitle = text(reveal, "", UDim2.new(1, -24, 0.35, 0), UDim2.fromOffset(12, 12), 25)
local revealDetail = text(reveal, "", UDim2.new(1, -24, 0.25, 0), UDim2.new(0, 12, 0.4, 0), 18)
button(reveal, "Continuar", UDim2.new(1, -32, 0, 40), UDim2.new(0, 16, 1, -52), function() reveal.Visible = false end)
remote.OnClientEvent:Connect(function(action, value, extra)
    if action == "State" then
        local first = state == nil
        state = value
        render()
        if first then
            toast("Bem-vindo! Clique em um inimigo ou abra Missões para aprender.")
            if player:GetAttribute("SessionOnly") then toast("Modo Studio: progresso apenas nesta sessão.") end
        end
    elseif action == "Toast" then toast(value)
    elseif action == "Target" then highlight.Adornee, stop.Visible = value, value ~= nil
    elseif action == "Summoned" then
        local def = Config.GetFighter(value.Kind)
        revealTitle.Text, revealTitle.TextColor3 = def.Name, def.Color
        revealDetail.Text = def.Rarity .. " · Poder " .. number(Config.Power(value))
        reveal.Visible = true
    elseif action == "Damage" then
        local anchor = Instance.new("Part")
        anchor.Anchored, anchor.CanCollide, anchor.Transparency, anchor.Size = true, false, 1, Vector3.new(1, 1, 1)
        anchor.Position, anchor.Parent = value + Vector3.new(0, 5, 0), workspace
        local board = Instance.new("BillboardGui")
        board.Size, board.AlwaysOnTop, board.Parent = UDim2.fromOffset(160, 50), true, anchor
        local amount = text(board, "−" .. number(extra), UDim2.fromScale(1, 1), UDim2.new(), 30, Color3.fromRGB(255, 219, 107))
        amount.TextStrokeTransparency = 0.2
        TweenService:Create(anchor, TweenInfo.new(0.8), {Position = anchor.Position + Vector3.new(0, 4, 0)}):Play()
        TweenService:Create(amount, TweenInfo.new(0.8), {TextTransparency = 1}):Play()
        Debris:AddItem(anchor, 1)
    end
end)
task.spawn(function()
    while not state do remote:FireServer("Ready"); task.wait(1) end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="7">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>